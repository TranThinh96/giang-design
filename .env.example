# Copy to .env.local and fill in. Names only — never commit real values.
# .gitignore already covers .env.local; verify before your first push.

# --- Zalo -------------------------------------------------------------------
# Zalo Official Account ID, from https://oa.zalo.me → Quản lý OA → Thông tin.
# Enables the floating OA chat widget site-wide. Without it the widget is not
# rendered and no Zalo script loads; every quote CTA still opens the zalo.me
# deep link derived from the phone number in the CMS, so the contact path keeps
# working.
NEXT_PUBLIC_ZALO_OA_ID=

# --- Keystatic admin (/keystatic) -------------------------------------------
# Required in production only. `keystatic.config.ts` uses local file storage in
# development, so `npm run dev` needs none of these.
#
# All four are generated for you: deploy the site, open /keystatic/setup and
# follow the wizard — it creates the GitHub App and prints the values. Paste
# them into the Vercel project's Environment Variables, then redeploy.
#
# Without them the marketing site still builds and serves normally; only
# /api/keystatic returns an error.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
