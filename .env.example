# Copy to .env.local and fill in. Names only — never commit real values.
# .gitignore already covers .env.local; verify before your first push.

# --- Zalo -------------------------------------------------------------------
# Zalo Official Account ID, from https://oa.zalo.me → Quản lý OA → Thông tin.
# Enables the floating OA chat widget site-wide. Without it the widget is not
# rendered and no Zalo script loads; every quote CTA still opens the zalo.me
# deep link derived from the phone number in the CMS, so the contact path keeps
# working.
NEXT_PUBLIC_ZALO_OA_ID=

# --- Keystatic admin (/keystatic) -------------------------------------------
# Required in production only. `keystatic.config.ts` uses local file storage in
# development, so `npm run dev` needs none of these.
#
# Without all four the marketing site still builds and serves normally; only
# /dang-nhap and /api/keystatic return an error.

# The credentials the editor types at /dang-nhap. There is one account and no
# user table — changing the password here logs every open session out.
# Use a long passphrase: it is worth exactly as much as the token below.
KEYSTATIC_ADMIN_USERNAME=
KEYSTATIC_ADMIN_PASSWORD=

# The GitHub account every edit commits as. Create at
# github.com/settings/personal-access-tokens → Fine-grained token, repository
# access limited to TranThinh96/giang-design, permission Contents:
# Read & write, nothing else. Fine-grained tokens expire — put the renewal date
# in a calendar, because the admin stops saving the day it lapses.
#
# This token is handed to the editor's browser after login: that is how
# Keystatic's GitHub mode works (the admin talks to GitHub's API client-side).
# Scope it to this one repo and treat it as public to anyone who can log in.
KEYSTATIC_GITHUB_TOKEN=

# Signs the admin session cookie. Any long random string —
# `openssl rand -base64 32`. Rotating it logs every open session out.
KEYSTATIC_SECRET=
